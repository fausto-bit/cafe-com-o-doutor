---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SINONIMOS } from '../data/sinonimos';
---

<BaseLayout
  title="Buscar nos ensaios — Café com o Doutor"
  description="Procure um assunto nos ensaios do Café com o Doutor."
  noindex={true}
>
  <section class="busca-page wrap">
    <h1 class="font-display">Buscar nos ensaios</h1>
    <p class="busca-ajuda">Escreva uma palavra ou duas. Não precisa acertar a grafia nem usar acento.</p>

    <form class="busca-form" role="search" id="busca-form">
      <input
        id="busca-input"
        type="search"
        name="q"
        placeholder="Ex.: queda, remédio, memória, sono…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Buscar nos ensaios"
      />
      <button type="submit" class="btn btn-pill btn-coral">Buscar</button>
    </form>

    <p class="busca-status" id="busca-status" aria-live="polite"></p>
    <ul class="menu" id="busca-resultados"></ul>
  </section>
  <script type="application/json" id="busca-sinonimos" set:html={JSON.stringify(SINONIMOS)} />
</BaseLayout>

<script>
  import MiniSearch from 'minisearch';
  import { STOP, normaliza, fonetiza, tolerancia, prepararGatilhos, montarConsulta, semCauda } from '../lib/busca';

  type Registro = {
    id: string;
    titulo: string;
    subtitulo: string;
    categoria: string;
    tempo: string;
    data: string;
    descricao: string;
    temas: string;
    corpo: string;
  };

  const gatilhos = prepararGatilhos(
    JSON.parse(document.getElementById('busca-sinonimos')!.textContent ?? '[]'),
  );

  const processTerm = (termo: string) => {
    const t = normaliza(termo);
    return STOP.has(t) ? null : fonetiza(t);
  };

  const form = document.getElementById('busca-form') as HTMLFormElement;
  const input = document.getElementById('busca-input') as HTMLInputElement;
  const status = document.getElementById('busca-status') as HTMLElement;
  const lista = document.getElementById('busca-resultados') as HTMLUListElement;

  let motor: MiniSearch<Registro> | null = null;
  let porId = new Map<string, Registro>();
  let carregando: Promise<void> | null = null;

  function carregar(): Promise<void> {
    if (carregando) return carregando;
    carregando = fetch('/busca-index.json')
      .then((r) => r.json())
      .then((dados: Registro[]) => {
        porId = new Map(dados.map((d) => [d.id, d]));
        motor = new MiniSearch<Registro>({
          fields: ['titulo', 'subtitulo', 'temas', 'categoria', 'descricao', 'corpo'],
          storeFields: [],
          processTerm,
          searchOptions: {
            boost: { titulo: 6, temas: 4, subtitulo: 3, categoria: 2, descricao: 2 },
            prefix: (termo: string) => termo.length >= 4,
            fuzzy: tolerancia,
          },
        });
        motor.addAll(dados);
      });
    return carregando;
  }

  // Mostra o pedaço do texto onde apareceu uma das palavras que casaram.
  function trecho(r: Registro, termos: string[]): string {
    const palavras = r.corpo.split(' ');
    const alvo = new Set(termos);
    const i = palavras.findIndex((w) => alvo.has(fonetiza(w.replace(/[^p{L}p{N}]/gu, ''))));
    if (i < 0) return r.descricao;
    const ini = Math.max(0, i - 12);
    const fim = Math.min(palavras.length, i + 20);
    return (ini > 0 ? '…' : '') + palavras.slice(ini, fim).join(' ') + (fim < palavras.length ? '…' : '');
  }

  function desenhar(achados: { id: string; terms: string[] }[]) {
    lista.replaceChildren();
    for (const { id, terms } of achados) {
      const r = porId.get(id);
      if (!r) continue;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/artigos/${r.id}/`;
      a.className = 'menu-item';
      const texto = document.createElement('div');
      texto.className = 'menu-item-text';
      const tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = r.categoria;
      const h3 = document.createElement('h3');
      h3.className = 'font-display';
      h3.textContent = r.titulo;
      const p = document.createElement('p');
      p.className = 'busca-trecho';
      p.textContent = trecho(r, terms);
      texto.append(tag, h3, p);
      const tempo = document.createElement('span');
      tempo.className = 'menu-time';
      tempo.textContent = r.tempo;
      a.append(texto, tempo);
      li.append(a);
      lista.append(li);
    }
  }

  async function buscar(consulta: string) {
    const q = consulta.trim();
    if (!q) {
      lista.replaceChildren();
      status.textContent = '';
      return;
    }
    status.textContent = 'Buscando…';
    try {
      await carregar();
    } catch {
      status.textContent = 'Não consegui carregar a busca agora. Tente de novo em instantes.';
      return;
    }
    if (input.value.trim() !== q) return; // a pessoa já digitou outra coisa
    // Todas as palavras; se nada vier, qualquer uma delas.
    let achados = [] as ReturnType<MiniSearch<Registro>['search']>;
    for (const modo of ['AND', 'OR'] as const) {
      const consulta = montarConsulta(q, gatilhos, modo);
      if (!consulta) break;
      achados = semCauda(motor!.search(consulta));
      if (achados.length) break;
    }
    desenhar(achados.map((x) => ({ id: String(x.id), terms: x.terms })));
    status.textContent =
      achados.length === 0
        ? 'Nada encontrado. Tente outra palavra ou uma parte dela.'
        : `${achados.length} ${achados.length === 1 ? 'ensaio encontrado' : 'ensaios encontrados'}`;
  }

  let espera: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(espera);
    espera = window.setTimeout(() => {
      buscar(input.value);
      const url = new URL(location.href);
      if (input.value.trim()) url.searchParams.set('q', input.value.trim());
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }, 180);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    buscar(input.value);
    input.blur();
  });

  const inicial = new URLSearchParams(location.search).get('q');
  if (inicial) {
    input.value = inicial;
    buscar(inicial);
  } else {
    input.focus();
    carregar().catch(() => {});
  }
</script>

<style is:global>
  .busca-page {
    padding: 40px 24px 56px;
  }
  .busca-page h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-style: italic;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .busca-ajuda {
    color: var(--clay);
    margin: 0 0 20px;
  }
  .busca-form {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  .busca-form input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1.05rem;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 12px 20px;
  }
  .busca-form input:focus {
    outline: none;
    border-color: var(--coral);
  }
  .busca-status {
    color: var(--clay);
    font-size: 0.9rem;
    min-height: 1.4em;
    margin: 0 0 14px;
  }
  .busca-trecho {
    margin: 0;
    font-size: 0.9rem;
    color: var(--clay);
    line-height: 1.5;
  }
</style>
