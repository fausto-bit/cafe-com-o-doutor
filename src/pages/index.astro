---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const artigos = (await getCollection('artigos')).sort((a, b) =>
  (b.data.data ?? '').localeCompare(a.data.data ?? '')
);
---

<BaseLayout title="Café com o Doutor — um blog de bolso sobre envelhecer bem">
  <section class="hero wrap">
    <p class="eyebrow">um blog de bolso sobre envelhecer bem</p>
    <h1 class="font-display">Café com o Doutor</h1>
    <p class="subtext">
      Ensaios e guias práticos do Dr. Fausto Azambuja sobre longevidade, cérebro e família —
      escritos como uma conversa, não como uma bula.
    </p>
    <div class="hero-ctas">
      {artigos[0] && (
        <a class="btn btn-pill btn-coral" href={`/artigos/${artigos[0].id}`}>Ler o último ensaio</a>
      )}
      <a class="btn btn-pill btn-outline" href="#sobre">Sobre este espaço</a>
    </div>
  </section>

  <svg class="steam-divider" viewBox="0 0 120 24" width="120" height="24" aria-hidden="true">
    <path d="M2 20 Q 15 4, 30 12 T 58 12 T 86 12 T 114 12" />
    <path d="M2 16 Q 15 0, 30 8 T 58 8 T 86 8 T 114 8" />
  </svg>

  <section class="cardapio wrap" id="cardapio">
    <h2 class="font-display">Hoje no cardápio</h2>
    <ul class="menu">
      {artigos.map((artigo) => (
        <li>
          <a href={`/artigos/${artigo.id}`} class="menu-item">
            <div class="menu-item-text">
              <span class="tag">{artigo.data.categoria}</span>
              <h3 class="font-display">{artigo.data.titulo}</h3>
            </div>
            <span class="menu-time">{artigo.data.tempo_leitura}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="sobre wrap" id="sobre">
    <h2 class="font-display">Sobre este espaço</h2>
    <p>
      Sou o Dr. Fausto Azambuja, médico geriatra em Belo Horizonte, com mais de vinte anos de
      consultório.
    </p>
    <p>
      Nesse tempo todo, aprendi que a Medicina fala demais sobre doença — e pouco sobre o resto:
      força, memória, propósito, autonomia. O Café com o Doutor nasceu para ocupar esse espaço:
      músculo tanto quanto medicamento, prevenção tanto quanto diagnóstico, propósito tanto quanto
      exame. Envelhecer bem não é apenas não estar doente.
    </p>
    <p>
      Os textos nascem primeiro aqui — antes de qualquer outro lugar, inclusive da newsletter.
    </p>
    <p>
      Se quiser conhecer meu trabalho clínico, visite
      <a href="https://drfaustoazambuja.com.br" target="_blank" rel="noopener">drfaustoazambuja.com.br</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 8px;
    text-align: center;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--coral);
    margin: 0 0 12px;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 3.8rem);
    font-style: italic;
    font-weight: 600;
  }
  .subtext {
    max-width: 46ch;
    margin: 20px auto 0;
    color: var(--clay);
    font-size: 1.1rem;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .steam-divider {
    display: block;
    margin: 8px auto 0;
  }

  .cardapio {
    padding-top: 40px;
    padding-bottom: 56px;
  }
  .cardapio > h2 {
    font-size: 1.8rem;
    font-style: italic;
    margin-bottom: 24px;
  }
  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    text-decoration: none;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px 24px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .menu-item:hover {
    border-color: var(--coral);
    transform: translateY(-1px);
  }
  .menu-item-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .menu-item-text h3 {
    font-size: 1.15rem;
    font-weight: 600;
    font-style: italic;
  }
  .menu-time {
    color: var(--clay);
    font-size: 0.85rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sobre {
    padding-top: 8px;
    padding-bottom: 56px;
  }
  .sobre h2 {
    font-size: 1.6rem;
    font-style: italic;
    margin-bottom: 16px;
  }
  .sobre p {
    color: var(--ink);
    max-width: 62ch;
  }
  .sobre a {
    color: var(--coral-deep);
  }
</style>
