---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtigoItem from '../components/ArtigoItem.astro';
import { temasEmUso } from '../data/tags';

const artigos = (await getCollection('artigos')).sort((a, b) =>
  (b.data.data ?? '').localeCompare(a.data.data ?? '')
);
const temas = temasEmUso(artigos);
---

<BaseLayout
  title="Café com o Doutor | Geriatria e Slow Medicine em Belo Horizonte"
  description="Ensaios e guias práticos do Dr. Fausto Azambuja, geriatra e clínico em Belo Horizonte. Slow Medicine com alta tecnologia: tempo para ouvir, ciência para decidir."
  showTelegram={true}
  canonicalPath="/"
>
  <section class="hero wrap">
    <p class="eyebrow">Geriatria e Clínica Médica · Slow Medicine + alta tecnologia · Belo Horizonte</p>
    <h1 class="font-display">Café com o Doutor</h1>
    <p class="subtext">
      Ensaios e guias práticos do Dr. Fausto Azambuja sobre envelhecer com autonomia: tempo para
      entender cada pessoa, tecnologia e evidência para cuidar bem. Escritos como uma conversa,
      não como uma bula.
    </p>
    <div class="hero-ctas">
      {artigos[0] && (
        <a class="btn btn-pill btn-coral" href={`/artigos/${artigos[0].id}/`}>Ler o último ensaio</a>
      )}
      <a class="btn btn-pill btn-outline" href="#sobre">Sobre este espaço</a>
    </div>
  </section>

  <svg class="steam-divider" viewBox="0 0 120 24" width="120" height="24" aria-hidden="true">
    <path d="M2 20 Q 15 4, 30 12 T 58 12 T 86 12 T 114 12" />
    <path d="M2 16 Q 15 0, 30 8 T 58 8 T 86 8 T 114 8" />
  </svg>

  <section class="cardapio wrap" id="cardapio">
    <h2 class="font-display">Hoje no cardápio</h2>
    <ul class="menu">
      {artigos.map((artigo) => <ArtigoItem artigo={artigo} showCategoria={true} />)}
    </ul>
  </section>

  {temas.length > 0 && (
    <section class="assuntos wrap" aria-labelledby="assuntos-titulo">
      <h2 id="assuntos-titulo" class="font-display">Assuntos</h2>
      <ul class="assuntos-lista">
        {temas.map((t) => (
          <li>
            <a href={`/temas/${t.slug}/`} class="assunto-chip">
              {t.rotulo} <span class="assunto-n">{t.n}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="sobre wrap" id="sobre">
    <h2 class="font-display">Sobre este espaço</h2>
    <p>
      Sou o Dr. Fausto Azambuja, geriatra e clínico em Belo Horizonte. Pratico Slow Medicine com
      alta tecnologia: consultas sem pressa, em que o tempo serve para ouvir a história de cada
      pessoa, e ferramentas modernas (avaliação funcional estruturada, revisão criteriosa de
      medicamentos, acompanhamento contínuo) para decidir com precisão. O Café com o Doutor leva
      essa conversa para além do consultório: músculo tanto quanto medicamento, prevenção tanto
      quanto diagnóstico, propósito tanto quanto exame.
    </p>
    <p><a href="/sobre/">Conheça mais sobre o autor →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 8px;
    text-align: center;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--coral);
    margin: 0 0 12px;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 3.8rem);
    font-style: italic;
    font-weight: 600;
  }
  .subtext {
    max-width: 46ch;
    margin: 20px auto 0;
    color: var(--clay);
    font-size: 1.1rem;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .steam-divider {
    display: block;
    margin: 8px auto 0;
  }

  .assuntos {
    padding-top: 8px;
    padding-bottom: 48px;
  }
  .assuntos > h2 {
    font-size: 1.6rem;
    font-style: italic;
    margin-bottom: 16px;
  }
  .assuntos-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 640px) {
    .assuntos-lista {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x proximity;
    }
    .assuntos-lista li {
      flex-shrink: 0;
      scroll-snap-align: start;
    }
  }
  .assunto-chip {
    display: inline-block;
    white-space: nowrap;
    font-family: 'Karla', sans-serif;
    font-size: 0.88rem;
    color: var(--ink);
    text-decoration: none;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 6px 14px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .assunto-chip:hover {
    border-color: var(--coral);
    color: var(--coral-deep);
  }
  .assunto-n {
    color: var(--clay);
    font-size: 0.78rem;
    margin-left: 4px;
  }

  .cardapio {
    padding-top: 40px;
    padding-bottom: 48px;
  }
  .cardapio > h2 {
    font-size: 1.8rem;
    font-style: italic;
    margin-bottom: 24px;
  }

  .sobre {
    padding-top: 8px;
    padding-bottom: 56px;
  }
  .sobre h2 {
    font-size: 1.6rem;
    font-style: italic;
    margin-bottom: 16px;
  }
  .sobre p {
    color: var(--ink);
    max-width: 62ch;
  }
  .sobre a {
    color: var(--coral-deep);
  }
</style>
