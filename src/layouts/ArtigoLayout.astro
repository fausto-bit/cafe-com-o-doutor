---
import BaseLayout from './BaseLayout.astro';
import { slugifyCategoria } from '../lib/slugify.mjs';
import AutorBox from '../components/AutorBox.astro';
import { slugTema } from '../data/tags';

interface Props {
  slug: string;
  titulo: string;
  subtitulo?: string;
  categoria: string;
  tempo_leitura: string;
  autor: string;
  data?: string;
  imagem_capa?: string;
  resumo?: string;
  descricao?: string;
  resumoWhatsapp?: string;
  tags?: string[];
}

const {
  slug,
  titulo,
  subtitulo,
  categoria,
  tempo_leitura,
  autor,
  data,
  imagem_capa,
  resumo,
  descricao,
  resumoWhatsapp,
  tags,
} = Astro.props;

const dataFormatada = data
  ? new Date(`${data}T00:00:00`).toLocaleDateString('pt-BR', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    })
  : null;

const catSlug = slugifyCategoria(categoria);
const catPath = `/categoria/${catSlug}/`;
const breadcrumbs = [
  { name: 'Café com o Doutor', path: '/' },
  { name: categoria, path: catPath },
  { name: titulo, path: `/artigos/${slug}/` },
];
---

<BaseLayout
  title={`${titulo} — Café com o Doutor`}
  description={descricao ?? resumo ?? subtitulo}
  ogImage={imagem_capa || undefined}
  canonicalPath={`/artigos/${slug}/`}
  keywords={tags}
  articleMeta={{ headline: titulo, autor, datePublished: data || undefined, keywords: tags }}
  breadcrumbs={breadcrumbs}
>
  <article class="wrap artigo">
    <nav class="breadcrumbs" aria-label="breadcrumb">
      <a href="/">Início</a> <span class="sep" aria-hidden="true">/</span>
      <a href={catPath}>{categoria}</a>
    </nav>
    <header class="artigo-header">
      <a class="tag" href={catPath}>{categoria}</a>
      <h1 class="font-display">{titulo}</h1>
      {subtitulo && <p class="subtitulo">{subtitulo}</p>}
      {tags && tags.length > 0 && (
        <p class="hashtags">
          {tags.map((tag) => (
            <a href={`/temas/${slugTema(tag)}/`}>#{tag}</a>
          ))}
        </p>
      )}
      <p class="meta">
        {autor} · {tempo_leitura} de leitura{dataFormatada ? ` · ${dataFormatada}` : ''}
      </p>
    </header>

    <svg class="steam-divider" viewBox="0 0 120 24" width="120" height="24" aria-hidden="true">
      <path d="M2 20 Q 15 4, 30 12 T 58 12 T 86 12 T 114 12" />
      <path d="M2 16 Q 15 0, 30 8 T 58 8 T 86 8 T 114 8" />
    </svg>

    <div class="prose">
      <slot />
    </div>

    {resumoWhatsapp && (
      <div class="copiar-whatsapp">
        <button id="copyWhatsappBtn" type="button" class="btn btn-pill btn-outline" data-resumo={resumoWhatsapp}>
          Copiar resumo para WhatsApp
        </button>
      </div>
    )}

    <AutorBox />
  </article>
</BaseLayout>

{resumoWhatsapp && (
  <script>
    const btn = document.getElementById('copyWhatsappBtn');
    if (btn instanceof HTMLButtonElement) {
      const original = btn.textContent;
      btn.addEventListener('click', async () => {
        const texto = `${btn.dataset.resumo ?? ''}\n${window.location.href}`;
        try {
          await navigator.clipboard.writeText(texto);
          btn.textContent = 'Copiado!';
        } catch {
          btn.textContent = 'Não foi possível copiar';
        }
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      });
    }
  </script>
)}

<style>
  .artigo {
    padding-top: 48px;
    padding-bottom: 64px;
  }
  .artigo :global(.breadcrumbs) {
    text-align: center;
  }
  .artigo-header {
    text-align: center;
    margin-bottom: 8px;
  }
  .artigo-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-style: italic;
    font-weight: 600;
    margin: 16px 0 12px;
  }
  .subtitulo {
    font-family: 'Karla', sans-serif;
    color: var(--clay);
    font-size: 1.05rem;
    max-width: 46ch;
    margin: 0 auto 14px;
  }
  .hashtags {
    font-family: 'Karla', sans-serif;
    color: var(--coral-deep);
    font-size: 0.88rem;
    max-width: 52ch;
    margin: 0 auto 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
  }
  .hashtags a {
    color: inherit;
    text-decoration: none;
  }
  .hashtags a:hover {
    text-decoration: underline;
  }
  .meta {
    color: var(--clay);
    font-size: 0.9rem;
    margin: 0;
  }
  .steam-divider {
    margin-top: 4px;
  }
  .copiar-whatsapp {
    text-align: center;
    margin-top: 24px;
  }
</style>

<style is:global>
  .prose {
    font-size: 1.08rem;
  }
  .prose > p:first-of-type {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .prose h2 {
    font-size: 1.5rem;
    font-style: italic;
    padding-top: 24px;
    margin-top: 48px;
    border-top: 1px dashed var(--line);
  }
  .prose blockquote {
    border-left: 3px solid var(--coral);
    padding: 4px 22px;
    font-style: italic;
    margin: 32px 0;
  }
  .prose blockquote p {
    margin: 8px 0;
  }
  .prose blockquote.alert {
    font-style: normal;
    background: var(--card);
    border-left: 3px solid var(--coral);
    border-radius: 0 10px 10px 0;
    padding: 18px 24px;
  }
  .prose .glance {
    margin: 32px 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .prose .glance p {
    margin: 0;
    padding: 14px 22px;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .prose .glance .glance-title {
    background: var(--card);
    font-family: 'Karla', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clay);
    padding: 10px 22px;
  }
  .prose .glance .g-192 { background: var(--coral-deep); color: #fff; }
  .prose .glance .g-hoje { background: var(--clay); color: #fff; }
  .prose .glance .g-dias { background: var(--ink); color: var(--paper); }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
    font-size: 0.95rem;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
  }
  .prose th {
    font-family: 'Karla', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--clay);
    border-bottom: 2px solid var(--coral);
  }
  .prose td:first-child {
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .prose table {
      display: block;
      overflow-x: auto;
      font-size: 0.85rem;
    }
    .prose th,
    .prose td {
      padding: 8px 8px;
    }
  }
  .prose p > img {
    border-radius: 14px;
    margin: 0 auto;
  }
  .prose p:has(> img:only-child) {
    margin-bottom: 6px;
  }
  .prose p:has(> em:only-child) {
    text-align: center;
    font-style: italic;
    color: var(--clay);
    font-size: 0.88rem;
    margin-top: 0;
    margin-bottom: 32px;
  }

  /* Bloco de assinatura final — sempre a última seção do artigo */
  .prose h2:last-of-type {
    border-top: 1px solid var(--line);
    border-bottom: none;
    background: var(--card);
    padding: 28px 28px 4px;
    margin-left: -28px;
    margin-right: -28px;
    margin-top: 56px;
    border-radius: 16px 16px 0 0;
    font-style: italic;
  }
  .prose h2:last-of-type ~ * {
    background: var(--card);
    padding-left: 28px;
    padding-right: 28px;
    margin-left: -28px;
    margin-right: -28px;
  }
  .prose h2:last-of-type ~ *:last-child {
    border-bottom: 1px solid var(--line);
    padding-bottom: 28px;
    border-radius: 0 0 16px 16px;
  }
</style>
