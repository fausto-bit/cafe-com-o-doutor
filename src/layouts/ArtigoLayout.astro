---
import BaseLayout from './BaseLayout.astro';

interface Props {
  titulo: string;
  categoria: string;
  tempo_leitura: string;
  autor: string;
  data?: string;
  imagem_capa: string;
}

const { titulo, categoria, tempo_leitura, autor, data, imagem_capa } = Astro.props;

const dataFormatada = data
  ? new Date(`${data}T00:00:00`).toLocaleDateString('pt-BR', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    })
  : null;
---

<BaseLayout title={`${titulo} — Café com o Doutor`} ogImage={imagem_capa}>
  <article class="wrap artigo">
    <header class="artigo-header">
      <span class="tag">{categoria}</span>
      <h1 class="font-display">{titulo}</h1>
      <p class="meta">
        {autor} · {tempo_leitura} de leitura{dataFormatada ? ` · ${dataFormatada}` : ''}
      </p>
    </header>

    <svg class="steam-divider" viewBox="0 0 120 24" width="120" height="24" aria-hidden="true">
      <path d="M2 20 Q 15 4, 30 12 T 58 12 T 86 12 T 114 12" />
      <path d="M2 16 Q 15 0, 30 8 T 58 8 T 86 8 T 114 8" />
    </svg>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .artigo {
    padding-top: 48px;
    padding-bottom: 64px;
  }
  .artigo-header {
    text-align: center;
    margin-bottom: 8px;
  }
  .artigo-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-style: italic;
    font-weight: 600;
    margin: 16px 0 12px;
  }
  .meta {
    color: var(--clay);
    font-size: 0.9rem;
    margin: 0;
  }
  .steam-divider {
    margin-top: 4px;
  }
</style>

<style is:global>
  .prose {
    font-size: 1.08rem;
  }
  .prose > p:first-of-type {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .prose h2 {
    font-size: 1.5rem;
    font-style: italic;
    padding-top: 24px;
    margin-top: 48px;
    border-top: 1px dashed var(--line);
  }
  .prose blockquote {
    border-left: 3px solid var(--coral);
    padding: 4px 22px;
    font-style: italic;
    margin: 32px 0;
  }
  .prose blockquote p {
    margin: 8px 0;
  }
  .prose blockquote.alert {
    font-style: normal;
    background: var(--card);
    border-left: 3px solid var(--coral);
    border-radius: 0 10px 10px 0;
    padding: 18px 24px;
  }
  .prose p > img {
    border-radius: 14px;
    margin: 0 auto;
  }
  .prose p:has(> img:only-child) {
    margin-bottom: 6px;
  }
  .prose p:has(> em:only-child) {
    text-align: center;
    font-style: italic;
    color: var(--clay);
    font-size: 0.88rem;
    margin-top: 0;
    margin-bottom: 32px;
  }

  /* Bloco de assinatura final — sempre a última seção do artigo */
  .prose h2:last-of-type {
    border-top: 1px solid var(--line);
    border-bottom: none;
    background: var(--card);
    padding: 28px 28px 4px;
    margin-left: -28px;
    margin-right: -28px;
    margin-top: 56px;
    border-radius: 16px 16px 0 0;
    font-style: italic;
  }
  .prose h2:last-of-type ~ * {
    background: var(--card);
    padding-left: 28px;
    padding-right: 28px;
    margin-left: -28px;
    margin-right: -28px;
  }
  .prose h2:last-of-type ~ *:last-child {
    border-bottom: 1px solid var(--line);
    padding-bottom: 28px;
    border-radius: 0 0 16px 16px;
  }
</style>
