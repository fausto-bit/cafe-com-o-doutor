---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Um blog de bolso sobre envelhecer bem, escrito pelo Dr. Fausto Azambuja.',
  ogImage = '/img/logo.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/img/logo.jpg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Karla:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">
          <img src="/img/logo.jpg" alt="Café com o Doutor" class="brand-mark" />
          <span class="brand-word">Café com o Doutor</span>
        </a>
        <nav class="nav-links">
          <a href="/#cardapio">Ensaios</a>
          <a href="/#assinar" class="btn btn-pill btn-coral">Assinar</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <section class="substack-strip" id="assinar">
      <div class="wrap substack-inner">
        <div>
          <h2>Receba os ensaios por e-mail</h2>
          <p>Tudo que nasce aqui também chega direto na sua caixa de entrada, pelo Substack.</p>
        </div>
        <a class="btn btn-pill btn-coral" href="https://cafecomodoutor.substack.com" target="_blank" rel="noopener">
          Assinar no Substack
        </a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <a class="brand" href="/">
          <img src="/img/logo.jpg" alt="Café com o Doutor" class="brand-mark" />
          <span class="brand-word">Café com o Doutor</span>
        </a>
        <div class="footer-links">
          <a href="https://drfaustoazambuja.com.br" target="_blank" rel="noopener">drfaustoazambuja.com.br</a>
          <a href="https://wa.me/55" target="_blank" rel="noopener">WhatsApp</a>
          <a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a>
        </div>
        <p class="footer-note">© {new Date().getFullYear()} Café com o Doutor. Conteúdo educativo — não substitui consulta médica.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #241713;
    --paper: #f6ecdd;
    --card: #fffbf3;
    --coral: #e64a34;
    --coral-deep: #c43a26;
    --clay: #8c6a52;
    --line: rgba(36, 23, 19, 0.14);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Karla', system-ui, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  .font-display {
    font-family: 'Fraunces', Georgia, serif;
    line-height: 1.15;
    margin: 0;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: auto;
  }
  .skip-link:focus {
    left: 24px;
    top: 12px;
    background: var(--ink);
    color: var(--paper);
    padding: 8px 16px;
    border-radius: 100px;
    z-index: 100;
  }

  /* Nav */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(246, 236, 221, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
    max-width: 920px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }
  .brand-word {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 0.95rem;
  }
  .nav-links a {
    text-decoration: none;
  }
  .nav-links a:not(.btn):hover {
    color: var(--coral);
  }

  /* Buttons */
  .btn {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 10px 22px;
    border: 1px solid transparent;
    cursor: pointer;
  }
  .btn-pill {
    border-radius: 100px;
  }
  .btn-coral {
    background: var(--coral);
    color: var(--card);
  }
  .btn-coral:hover {
    background: var(--coral-deep);
  }
  .btn-outline {
    background: transparent;
    border-color: var(--ink);
    color: var(--ink);
  }
  .btn-outline:hover {
    border-color: var(--coral);
    color: var(--coral);
  }

  /* Category tag */
  .tag {
    display: inline-block;
    border: 1px solid var(--clay);
    color: var(--clay);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 100px;
  }

  /* Steam divider */
  .steam-divider {
    display: block;
    margin: 8px auto 32px;
  }
  .steam-divider path {
    fill: none;
    stroke: var(--coral);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 6 10;
    animation: waft 6s linear infinite;
  }
  .steam-divider path:nth-child(2) {
    animation-duration: 8s;
    animation-direction: reverse;
    opacity: 0.6;
  }
  @keyframes waft {
    to {
      stroke-dashoffset: -160;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam-divider path {
      animation: none;
    }
  }

  /* Substack strip */
  .substack-strip {
    background: var(--card);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .substack-inner {
    max-width: 920px;
    padding-top: 40px;
    padding-bottom: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .substack-inner h2 {
    font-size: 1.4rem;
    margin-bottom: 6px;
  }
  .substack-inner p {
    color: var(--clay);
    margin: 0;
  }

  /* Footer */
  .site-footer {
    padding: 40px 0 32px;
  }
  .footer-inner {
    max-width: 920px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }
  .footer-links {
    display: flex;
    gap: 20px;
    font-size: 0.9rem;
  }
  .footer-links a {
    text-decoration: none;
    color: var(--clay);
  }
  .footer-links a:hover {
    color: var(--coral);
  }
  .footer-note {
    color: var(--clay);
    font-size: 0.82rem;
    margin: 0;
  }
</style>
